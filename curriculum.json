{
  "version": 1,
  "note": "Single source of truth for the Chatoken course. Consumed by apps/web at build time and by scripts/check_curriculum.py. Stage ids must match docs/stages/<id>.md and the web route /stage/<id>.",
  "parts": [
    {
      "id": "generate",
      "number": 1,
      "title": "Generate",
      "tagline": "a model can produce tokens",
      "stages": [
        "01-tokens",
        "02-forward-pass",
        "03-decoding"
      ]
    },
    {
      "id": "train",
      "number": 2,
      "title": "Train",
      "tagline": "a model can learn from data",
      "stages": [
        "04-training-loop",
        "05-training-knobs",
        "06-data-scale",
        "07-checkpoints"
      ]
    },
    {
      "id": "reuse",
      "number": 3,
      "title": "Reuse",
      "tagline": "stand on someone else's training",
      "stages": [
        "08-pretrained-gpt2",
        "09-prompt-format"
      ]
    },
    {
      "id": "align",
      "number": 4,
      "title": "Align",
      "tagline": "make it follow instructions and hold a conversation",
      "stages": [
        "10-instruction-sft",
        "11-lora",
        "12-chat-sft",
        "13-your-own-dataset",
        "14-compare-runs"
      ]
    },
    {
      "id": "ship",
      "number": 5,
      "title": "Ship",
      "tagline": "turn a model into a system",
      "stages": [
        "15-conversation-memory",
        "16-streaming-cancel",
        "17-deploy-limits"
      ]
    }
  ],
